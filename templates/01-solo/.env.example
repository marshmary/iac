# Copy to .env for your own reference (gitignored) and export the values in
# your shell before running tasks - the Taskfile does not auto-load .env.
# NEVER commit real credentials: only this empty example file is tracked.
# Fill in ONLY the block for your cloud.

# ---- AWS (or use `aws configure` / SSO instead of static keys) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=

# ---- Azure (service principal; humans can use `az login` instead) ----
ARM_SUBSCRIPTION_ID=
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_TENANT_ID=

# ---- Google Cloud (or `gcloud auth application-default login`) ----
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
