# Copy to .env (gitignored). The Taskfile auto-loads .env on every task
# (go-task `dotenv:`), so values here reach the engine and provider CLIs
# without shell exports; exporting in your shell works too and wins.
# NEVER commit real credentials: only this empty example file is tracked.
# Fill in ONLY the block for your cloud.

# ---- AWS (or use `aws configure` / SSO instead of static keys) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=

# ---- Azure (service principal; humans can use `az login` instead) ----
ARM_SUBSCRIPTION_ID=
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_TENANT_ID=

# ---- Google Cloud (or `gcloud auth application-default login`) ----
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
