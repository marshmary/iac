# ---------------------------------------------------------------------------
# Credentials template — copy to .env, fill in for YOUR cloud, never commit.
# .env and .env.* are gitignored; only .env.example is committed.
#
# POSIX shells:   set -a; source .env; set +a
# PowerShell:     copy the values into $env:<NAME> = "..." lines instead
# ---------------------------------------------------------------------------

# --- AWS (standard credential chain env vars) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=

# --- Azure (ARM_*) ---
# ARM_SUBSCRIPTION_ID=
# ARM_TENANT_ID=
# ARM_CLIENT_ID=
# ARM_CLIENT_SECRET=

# --- GCP ---
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_PROJECT=
# GOOGLE_REGION=
