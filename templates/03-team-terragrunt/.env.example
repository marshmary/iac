# ---------------------------------------------------------------------------
# Credentials template — copy to .env, fill in for YOUR cloud, never commit.
# .env and .env.* are gitignored; only .env.example is committed.
#
# The Taskfile auto-loads .env on every task (go-task `dotenv:`), so values
# here reach the engine and provider CLIs without shell exports; exporting in
# your shell works too and wins. CI usually prefers explicit exports.
# ---------------------------------------------------------------------------

# --- AWS (standard credential chain env vars) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=

# --- Azure (ARM_*) ---
# ARM_SUBSCRIPTION_ID=
# ARM_TENANT_ID=
# ARM_CLIENT_ID=
# ARM_CLIENT_SECRET=

# --- GCP ---
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_REGION=
