# Copy to .env (gitignored). The Taskfile auto-loads .env on every task
# (go-task `dotenv:`), so values here reach the engine and provider CLIs
# without shell exports; exporting in your shell works too and wins.
# NEVER commit real credentials: only this empty example file is tracked.
# After project init only ONE provider block is relevant - keep the one you use.

# ---- AWS ----
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # SSO / temporary credentials
# AWS_REGION=

# ---- Azure (azurerm v4 requires ARM_SUBSCRIPTION_ID) ----
# ARM_SUBSCRIPTION_ID=
# ARM_TENANT_ID=
# ARM_CLIENT_ID=
# ARM_CLIENT_SECRET=

# ---- GCP ----
# GOOGLE_APPLICATION_CREDENTIALS=C:/absolute/path/to/key.json
# GOOGLE_CLOUD_PROJECT=         # optional runtime override
