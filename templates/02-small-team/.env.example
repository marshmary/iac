# Copy to .env (gitignored - NEVER commit real credentials).
# The Taskfile auto-loads .env from the repo root.
# After project init only ONE provider block is relevant - keep the one you use.

# ---- AWS ----
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # SSO / temporary credentials

# ---- Azure (azurerm v4 requires ARM_SUBSCRIPTION_ID) ----
# ARM_SUBSCRIPTION_ID=
# ARM_TENANT_ID=
# ARM_CLIENT_ID=
# ARM_CLIENT_SECRET=

# ---- GCP ----
# GOOGLE_APPLICATION_CREDENTIALS=C:/absolute/path/to/key.json
# GOOGLE_PROJECT=               # optional runtime override
