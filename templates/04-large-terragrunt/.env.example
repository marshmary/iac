# -----------------------------------------------------------------------------
# .env.example - credential template (tier 04, multi-cloud).
#
# NEVER commit real credentials. Copy to `.env` (git-ignored) or export into
# your shell / CI secret store. This repo keeps NO secrets in git. The
# Taskfile auto-loads .env on every task (go-task `dotenv:`); shell exports
# still work and win, and CI usually prefers them.
#
# Notes:
#   - Only the block for the platform you are touching right now is needed.
#   - Assume-role / OIDC placeholders are for CI later; locally a plain
#     `aws sso login` / `az login` / `gcloud auth application-default login`
#     is usually enough.
# -----------------------------------------------------------------------------

# --- AWS (platforms/aws) -----------------------------------------------------
# Static keys are a LAST RESORT - prefer SSO or assumed roles.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...            # required for temporary keys
# AWS_REGION=us-east-1
#
# Cross-account role assumption (dev/prod accounts from common/accounts.hcl):
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/terraform-deploy
# AWS_ROLE_SESSION_NAME=terragrunt-local
#
# OIDC (GitHub Actions etc., wire in when CI lands):
# AWS_WEB_IDENTITY_TOKEN_FILE=/path/to/token
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/terraform-oidc

# --- Azure (platforms/azure) -------------------------------------------------
# ARM_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# ARM_TENANT_ID=00000000-0000-0000-0000-000000000000
# ARM_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ARM_CLIENT_SECRET=...            # prefer OIDC in CI: ARM_USE_OIDC=true

# --- Google Cloud (platforms/gcp) -------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_REGION=us-central1
