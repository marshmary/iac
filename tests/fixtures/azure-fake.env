# Fake Azure credentials for offline attempts (T3 best-effort only — the
# azurerm provider contacts AAD while configuring, so offline plans usually
# SKIP; these vars exist for emulator experiments and CI with proper OIDC).
ARM_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
ARM_TENANT_ID=00000000-0000-0000-0000-000000000000
ARM_CLIENT_ID=00000000-0000-0000-0000-000000000000
ARM_CLIENT_SECRET=fake-secret
ARM_SKIP_PROVIDER_REGISTRATION=true
# floci-az (T6, localhost:4577): only the storage/blob plane is emulated —
# enough for the azurerm state backend, not for ARM resource applies.
# ARM_USE_AZURE_CLI=false
